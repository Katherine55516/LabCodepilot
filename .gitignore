# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# pdfjs 离线资产（由 scripts/copy-doc-assets.js 从 node_modules/pdfjs-dist 生成）
/public/pdf/

# production
/build-next

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local database
/data/

# scratch / verification output (chrome-devtools screenshots, ad-hoc dumps)
.tmp/
screenshot/

# typescript
*.tsbuildinfo
next-env.d.ts

# electron
/dist-electron/
/release/
# Playwright headless_shell —— 打包时由 scripts/bundle-chromium.mjs 生成、
# electron-builder 复制进安装包的平台相关浏览器二进制(~192MB),绝不提交。
/ms-playwright-bundle/
# vfkit 虚拟机监视器 —— 打包时由 scripts/bundle-vfkit.mjs 从本机 brew 拷贝、
# electron-builder 复制进 Resources/cowork/bin/ 的二进制,绝不提交。
/vfkit-bundle/
/release-win/

# test artifacts
/playwright-report/
/test-results/
# Playwright visual regression snapshots are machine-specific (suffix is
# darwin/linux/etc) and regenerate on demand — don't commit them.
src/__tests__/e2e/*-snapshots/

# user uploads (runtime data)
.codepilot-uploads/

# local runtime artifacts
.codepilot/

# monorepo: site app build artifacts
apps/site/.next/
apps/site/.source/
apps/site/node_modules/

# claude code session data
.claude/

# Isolated live-test binary artifacts must not become Tailwind source.
/outputs/
/.next-incomplete-dependency-startup/
/.next-css-artifact-startup/

/.next-ppt-*/
