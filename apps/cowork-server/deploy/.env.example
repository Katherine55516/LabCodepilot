# Cowork 控制面环境变量 —— install.sh 首次部署会据此生成 /opt/cowork-server/.env
# (COWORK_AUTH_SECRET 自动填随机值);已存在的 .env 不覆盖。改完 systemctl restart cowork-server。

# ═══ 必填 ═══

# HMAC 鉴权密钥。客户端 token 由账号后端用【同一个】密钥签发(R5-5);server 只验签取
# uid,无状态不存用户表。留空 = authz 关闭、回退单用户(仅 dev/内网可信环境,勿用于生产)。
# 生成:openssl rand -hex 32
COWORK_AUTH_SECRET=

# claude 二进制 + cowork-shim.py 所在【宿主】目录,bind-mount 进会话容器 /opt/cowork:ro。
# 必须是 docker daemon 能解析的真实宿主路径(控制面是宿主进程,路径即宿主视角)。
COWORK_ASSETS_DIR=/opt/cowork-assets

# ═══ 可选(留空用默认)═══

# 监听端口
COWORK_SERVER_PORT=8790
# 监听地址。默认 0.0.0.0(客户端直连)。上 TLS 反代时设 127.0.0.1,让 caddy 独占对外、
# 明文端口不暴露公网(见 docker-compose.tls.yml)。
COWORK_SERVER_HOST=0.0.0.0

# 空闲会话回收(毫秒)。超时 docker stop 保留 volume,下次 ensure 秒级 docker start 复用。
COWORK_IDLE_TTL_MS=1800000

# 每会话容器配额
COWORK_CPUS=2
COWORK_MEM=2g
COWORK_PIDS=512

# 会话容器镜像。默认 python:3-slim + bind 宿主 assets(claude/shim);推荐切自建镜像
# (image/build-image.sh 构建,claude+shim+cred-proxy 烘入,离线更净、不依赖宿主 assets):
# COWORK_IMAGE=cowork-sandbox:latest
# COWORK_IMAGE_BUNDLED=1
# 切换后先 docker rm -f cowork-proxy 再 systemctl restart cowork-server(proxy running 时
# 不会自动按新镜像重建);存量会话容器仍旧镜像,TTL 回收/删除后新建的才用新镜像。
# COWORK_IMAGE=python:3-slim

# 备用全局静态口令 —— 仅当 COWORK_AUTH_SECRET 留空时生效(HMAC 优先)。生产用 HMAC,勿用此项。
# COWORK_SERVER_TOKEN=
